# Copy this file to .env and fill in your own values.

# IP address or hostname of your HDHomeRun tuner.
HDHR_HOST=

# User and group the container runs as. They need write access to OUTPUT_DIR.
# Run `id -u` and `id -g` to find yours.
PUID=
PGID=

# Host folder where guide.xml is written. Point your media server's XMLTV
# provider at guide.xml inside this folder.
OUTPUT_DIR=

# Hours between guide refreshes.
INTERVAL_HOURS=4
